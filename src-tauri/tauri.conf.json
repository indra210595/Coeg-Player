{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coeg Player",
  "version": "0.1.1",
  "identifier": "com.user.coeg-player-v2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Coeg Player",
        "width": 800,
        "height": 600,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "C:\\**",
          "C:/**",
          "$APPDATA/**",
          "$APPDATA\\**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFQTk4MjkyMDhEQ0QxRjQKUldUMDBkd0lrb0twamdobTJlaWQyYkhlTGFUNnpMM3psVHc4aFE1R2h1eXNKSnpLcXhTZWlkNFkK",
      "endpoints": [
        "https://github.com/indra210595/Coeg-Player/releases/latest/download/latest.json"
      ]
    }
  }
}
